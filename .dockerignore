# Build artifacts (rebuilt inside the image)
build/
**/build/
out/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json

# Frontend deps/output (not needed to build the server)
dashboard/node_modules/
dashboard/dist/

# Local runtime state. Without these, `COPY . .` bakes whatever metrics snapshot
# and offline spool happen to be on the build machine into the image -- so every
# container would start by additively restoring a stranger's counters and serving
# them as though they were this deployment's own history.
data/
spool/
**/spool/

# Secrets never belong in a build context: every file copied in stays recoverable
# from the image layers even if a later step deletes it.
.env
.env.*
!.env.example

# VCS and editor noise
.git/
.gitignore
.gitattributes
.github/
.vscode/
.idea/
.vs/
